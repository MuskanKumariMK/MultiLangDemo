@model List<MultiLangDemo.Models.LocalizationResource>

@{
    ViewData["Title"] =        "Manage Translations";
}

<div class="container mt-5">
    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body p-5">
            <h1 class="text-primary fw-bold mb-4">
                Runtime Localization
            </h1>

            <p class="text-muted mb-5">
                Update translations dynamically
                without restarting application.
            </p>

            <table class="table table-bordered align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Key</th>
                        <th>Culture</th>
                        <th>Value</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <form asp-action="UpdateTranslation" method="post">
                                <input type="hidden" name="Id" value="@item.Id" />
                            <td>
                                @item.Key
                            </td>

                            <td>
                                @item.Culture
                            </td>

                            <td>
                                <input type="text"
                                       name="Value"
                                       value="@item.Value"
                                       class="form-control" />
                            </td>

                            <td>
                                <button class="btn btn-success">
                                    Save
                                </button>
                            </td>
                            </form>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>