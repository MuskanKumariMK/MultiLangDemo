@using Microsoft.AspNetCore.Mvc.Localization
@using MultiLangDemo
@model MultiLangDemo.Models.UserModel
@inject IViewLocalizer Localizer
@inject IHtmlLocalizer<SharedResource>    SharedLocalizer

@{
    ViewData["Title"] = @Localizer["Login"];
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">   
            <div class="bg-primary text-white text-center p-4">
                <h2 class="fw-bold mb-2">
                    @Localizer["Login"]
                </h2>

                <p class="mb-0">
                    @Localizer["LoginSubtitle"]
                </p>
            </div>          

            <div class="card-body p-5">
                <form asp-action="Login" method="post">

                    <div class="mb-4 text-start">
                        <label asp-for="Email" class="form-label fw-semibold">                            
                        </label>
                        <input type="email"
                               class="form-control form-control-lg"
                               placeholder="@Localizer["EmailPlaceholder"]" />
                        <span asp-validation-for="Email"
                              class="text-danger small">

                        </span>

                    </div>

                    <div class="mb-4 text-start">
                        <label asp-for="Password" class="form-label fw-semibold">
                         
                        </label>
                        <input type="password"
                               class="form-control form-control-lg"
                               placeholder="@Localizer["PasswordPlaceholder"]" />
                        <span asp-validation-for="Password"
                              class="text-danger small">

                        </span>
                    </div>

                    <div class="form-check mb-4 text-start">
                        <input class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label">
                            
                        </label>
                    </div>
                    <div class="mb-4 text-start">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select form-select-lg">
                            <option value="0">@SharedLocalizer["Active"]</option>
                            <option value="1">@SharedLocalizer["Pending"]</option>
                            <option value="2">@SharedLocalizer["Blocked"]</option>
                        </select>

                    </div>

                    <div class="d-grid">
                        <button id="loginBtn" class="btn btn-primary btn-lg">
                            @Localizer["LoginButton"]
                        </button>
                    </div>
                </form>
            </div>
            @if (ViewBag.LoginMessage != null)
            {
                <div class="alert @(ViewBag.IsSuccess
                             ? "alert-success"
                             : "alert-danger") mt-4">

                @ViewBag.LoginMessage

                </div>
                        }
            <div class="card-footer bg-light text-center p-3">
                <small class="text-muted">
                    @Localizer["FooterText"]
                </small>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
 

    </script>
}